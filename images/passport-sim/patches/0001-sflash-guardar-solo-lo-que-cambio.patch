+    def save(self, address=None, length=None):
+        # Solo el pedazo que cambio: upstream reescribe los 8 MB en cada page program
+        # (256 bytes), y eso deja al firmware clavado en I/O apenas guarda settings.
+        if address is None:
+            with open(SPI_FLASH_SIM_PATH, 'wb') as f:
+                f.write(self.array)
+            return
+        with open(SPI_FLASH_SIM_PATH, 'r+b') as f:
+            f.seek(address)
+            f.write(self.array[address:address + length])
 
     def load(self):
